{
  "comment": "Paste into Cursor/Claude MCP config. Replace ${ORGANISM_HOME} with the absolute path of your workspace.",
  "mcpServers": {
    "organism-power": {
      "command": "python3",
      "args": [
        "${ORGANISM_HOME}/tools/mcp_organism_power/stdio_server.py"
      ]
    },
    "organism-continuity": {
      "command": "python3",
      "args": [
        "${ORGANISM_HOME}/tools/mcp_organism_continuity/stdio_server.py"
      ]
    }
  },
  "cli_smoke": [
    "python3 tools/mcp_organism_power/server.py list-tools",
    "python3 tools/mcp_organism_power/server.py call csv",
    "python3 tools/mcp_organism_continuity/server.py call peer_starter"
  ]
}
